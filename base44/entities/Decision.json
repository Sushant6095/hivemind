{
  "name": "Decision",
  "type": "object",
  "properties": {
    "space_id": { "type": "string" },
    "title": { "type": "string", "description": "Short statement of what was decided" },
    "detail": { "type": "string" },
    "status": { "type": "string", "enum": ["active", "superseded"], "default": "active" },
    "superseded_by": { "type": "string", "description": "Decision id that replaced this one" },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "source_msg_ids": { "type": "array", "items": { "type": "string" }, "description": "Provenance: Telegram message ids this was extracted from" },
    "decided_at": { "type": "string", "format": "date-time" },
    "member_emails": { "type": "array", "items": { "type": "string" } }
  },
  "required": ["space_id", "title"],
  "rls": {
    "read": { "member_emails": "{{user.email}}" },
    "create": false,
    "update": false,
    "delete": false
  }
}
