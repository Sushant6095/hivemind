{
  "name": "process-messages",
  "entry": "entry.ts",
  "automations": [
    {
      // The compiler pass: fires on every new RawMessage, debounces bursts internally.
      "type": "entity",
      "name": "on_raw_message_created",
      "description": "Compile new chat messages into Decisions/Commitments/Questions/Events/Expenses",
      "is_active": true,
      "entity_name": "RawMessage",
      "event_types": ["create"]
    },
    {
      // Sweeper: catches bursts that settled without a follow-up message.
      "type": "scheduled",
      "name": "burst_sweeper",
      "description": "Every 5 minutes, force-compile any settled unprocessed bursts",
      "is_active": true,
      "schedule_mode": "recurring",
      "schedule_type": "cron",
      "cron_expression": "*/5 * * * *",
      "function_args": { "sweep": true }
    }
  ]
}
