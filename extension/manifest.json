{
  "manifest_version": 3,
  "name": "Hivemind Sidekick",
  "version": "0.1.0",
  "description": "Your group chat, compiled — Hivemind's live board, feed and ledger in a Chrome side panel.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Open Hivemind Sidekick",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "sidepanel.html" },
  "permissions": ["sidePanel"]
}
